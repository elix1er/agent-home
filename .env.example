# Public URL of this deployment, without a trailing slash.
AGENT_HOME_URL=https://your-agent-home.vercel.app

# Auth0 API settings. Keep actual values only in Vercel/local environment.
AUTH0_ISSUER=https://your-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://your-agent-home.vercel.app/api/mcp
AUTH0_GITHUB_CLAIM=https://agent-home.dev/github_login

# Option A: fine-grained token scoped to this one private repo.
GITHUB_TOKEN=

# Option B (preferred for durable hosting): GitHub App credentials. Use either
# this complete group or GITHUB_TOKEN, never both. Preserve private-key newlines.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
